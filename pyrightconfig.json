{
  "pythonVersion": "3.14",
  "venvPath": ".",
  "venv": "venv",
  "typeCheckingMode": "standard",
  "include": [
    "config/__init__.py",
    "config/remote_mcp.py",
    "config/ai_settings.py",
    "lagniappe/__init__.py",
    "lagniappe/core/definitions/fetch.py",
    "lagniappe/core/entities/__init__.py",
    "lagniappe/core/tools/ai/auto_execute.py",
    "lagniappe/core/tools/ai/settings.py",
    "lagniappe/core/tools/ai/reporting/execution/request.py"
  ],
  "exclude": [
    "**/__pycache__",
    "lagniappe/web/static",
    "mcp/.venv",
    "mcp/.uv-cache",
    "node_modules",
    "reports",
    "venv"
  ]
}
