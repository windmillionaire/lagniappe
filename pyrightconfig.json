{
  "pythonVersion": "3.14",
  "venvPath": ".",
  "venv": "venv",
  "typeCheckingMode": "standard",
  "include": [
    "config",
    "lagniappe/core/definitions",
    "lagniappe/core/exceptions",
    "lagniappe/__init__.py",
    "lagniappe/core/entities/__init__.py",
    "lagniappe/core/tools/ai/auto_execute.py",
    "lagniappe/core/tools/ai/settings.py",
    "lagniappe/core/tools/ai/reporting/execution/request.py",
    "installer",
    "runner",
    "main.py",
    "run.py",
    "lagniappe/reference",
    "lagniappe/core/tools/cache",
    "lagniappe/core/tools/database",
    "lagniappe/core/entities/user.py",
    "lagniappe/core/properties/common_assets.py"
  ],
  "exclude": [
    "**/__pycache__",
    "lagniappe/web/static",
    "mcp/.venv",
    "mcp/.uv-cache",
    "node_modules",
    "reports",
    "venv"
  ]
}
