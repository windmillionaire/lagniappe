	"test_submission_select_multiple": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Select multiple form - list",
					"hash": "page001",
					"form": {
						"name": "Form",
						"hash": "form001",
						"schema": "select_only"
					},
					"form_submission": { "select-ab12": ["red", "blue"] },
					"expected": {
						"select-ab12": {
							"value": ["red", "blue"],
							"form_value": ["red", "blue"],
							"column_value": { "Red": "red", "Blue": "blue" },
							"filter_value": ["red", "blue"],
							"ai_value": ["Red", "Blue"]
						}
					}
				}
			],
			[
				"PAGE",
				{
					"name": "Select multiple AI - labels",
					"hash": "page002",
					"form": {
						"name": "Form",
						"hash": "form002",
						"schema": "select_only"
					},
					"ai_submission": { "select-ab12": ["Red", "Green"] },
					"expected": {
						"select-ab12": {
							"value": ["red", "green"],
							"form_value": ["red", "green"],
							"column_value": { "Red": "red", "Green": "green" },
							"filter_value": ["red", "green"],
							"ai_value": ["Red", "Green"]
						}
					}
				}
			],
			[
				"PAGE",
				{
					"name": "Select multiple import - comma separated",
					"hash": "page003",
					"form": {
						"name": "Form",
						"hash": "form003",
						"schema": "select_only"
					},
					"import_submission": { "select-ab12": ["Red, Blue, Green"] },
					"expected": {
						"select-ab12": {
							"field_attrs": { "separator": "," },
							"value": ["red", "blue", "green"],
							"form_value": ["red", "blue", "green"],
							"column_value": {
								"Red": "red",
								"Blue": "blue",
								"Green": "green"
							},
							"filter_value": ["red", "blue", "green"],
							"ai_value": ["Red", "Blue", "Green"]
						}
					}
				}
			],
			[
				"PAGE",
				{
					"name": "Select import - fuzzy match",
					"hash": "page004",
					"form": {
						"name": "Form",
						"hash": "form004",
						"schema": "select_only"
					},
					"import_submission": { "select-ab12": ["Rd", "Gren"] },
					"expected": {
						"select-ab12": {
							"field_attrs": { "fuzzy_match": true },
							"value": ["red", "green"],
							"form_value": ["red", "green"],
							"column_value": {
								"Red": "red",
								"Green": "green"
							},
							"filter_value": ["red", "green"],
							"ai_value": ["Red", "Green"]
						}
					}
				}
			]
		]
	},
