	"test_submission_bookmark_replace_flags_update_entity_fields": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Original Page Name",
					"description": "Original page description",
					"hash": "page003",
					"form": {
						"name": "Form",
						"hash": "form003",
						"schema": "bookmark_only"
					},
					"form_submission": {
						"bookmark-ab12:url": "https://bookmark.example.com",
						"bookmark-ab12:title": "Original Bookmark",
						"bookmark-ab12:replace-image": "on",
						"bookmark-ab12:replace-name": "on",
						"bookmark-ab12:replace-description": "on"
					},
					"expected": {
						"bookmark-ab12": {
							"value": {
								"url": "https://bookmark.example.com",
								"title": "Fetched Bookmark Title"
							},
							"form_value": {
								"url": "https://bookmark.example.com",
								"title": "Fetched Bookmark Title"
							},
							"filter_value": "Fetched Bookmark Title",
							"ai_value": {
								"url": "https://bookmark.example.com",
								"title": "Fetched Bookmark Title"
							}
						}
					}
				}
			]
		]
	},
	"test_submission_location": {
