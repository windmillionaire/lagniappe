{
	"test_submission_radio": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Radio form submission",
					"hash": "page001",
					"form": {
						"name": "Form",
						"hash": "form001",
						"schema": "radio_only"
					},
					"form_submission": { "radio-ab12": "opt1" },
					"expected": {
						"radio-ab12": {
							"value": "opt1",
							"form_value": "opt1",
							"column_value": { "Option One": "opt1" },
							"filter_value": "opt1",
							"ai_value": "Option One"
						}
					}
				}
			],
			[
				"PAGE",
				{
					"name": "Radio AI - using value",
					"hash": "page002",
					"form": {
						"name": "Form",
						"hash": "form002",
						"schema": "radio_only"
					},
					"ai_submission": { "radio-ab12": "opt2" },
					"expected": {
						"radio-ab12": {
							"value": "opt2",
							"form_value": "opt2",
							"column_value": { "Option Two": "opt2" },
							"filter_value": "opt2",
							"ai_value": "Option Two"
						}
					}
				}
			],
			[
				"PAGE",
				{
					"name": "Radio AI - using label (converts to value)",
					"hash": "page003",
					"form": {
						"name": "Form",
						"hash": "form003",
						"schema": "radio_only"
					},
					"ai_submission": { "radio-ab12": "Option Three" },
					"expected": {
						"radio-ab12": {
							"value": "opt3",
							"form_value": "opt3",
							"column_value": { "Option Three": "opt3" },
							"filter_value": "opt3",
							"ai_value": "Option Three"
						}
					}
				}
			],
			[
				"PAGE",
				{
					"name": "Radio import - exact match",
					"hash": "page004",
					"form": {
						"name": "Form",
						"hash": "form004",
						"schema": "radio_only"
					},
					"import_submission": { "radio-ab12": ["Option One"] },
					"expected": {
						"radio-ab12": {
							"value": "opt1",
							"form_value": "opt1",
							"column_value": { "Option One": "opt1" },
							"filter_value": "opt1",
							"ai_value": "Option One"
						}
					}
				}
			],
			[
				"PAGE",
				{
					"name": "Radio import - fuzzy match",
					"hash": "page005",
					"form": {
						"name": "Form",
						"hash": "form005",
						"schema": "radio_only"
					},
					"import_submission": { "radio-ab12": ["Opt Two"] },
					"expected": {
						"radio-ab12": {
							"field_attrs": { "fuzzy_match": true },
							"value": "opt2",
							"form_value": "opt2",
							"column_value": { "Option Two": "opt2" },
							"filter_value": "opt2",
							"ai_value": "Option Two"
						}
					}
				}
			]
		]
	},
