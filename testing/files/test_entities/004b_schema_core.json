{
	"test_schema_validate_ai_filters_invalid_top_level": {
		"entities": [
			[
				"FORM",
				{
					"name": "AI schema filter",
					"hash": "form_ai_filt",
					"ai_payload": [
						{ "id": "bad", "type": "not_a_schema_type", "title": "Bad" },
						{ "id": "bad_none_type", "type": null, "title": "Bad null type" },
						{
							"id": "bad_missing_input",
							"type": "input",
							"input": null,
							"title": "Bad null input"
						},
						{ "id": null, "type": "textarea", "title": "Bad null id" },
						"not-an-object",
						{
							"id": "good",
							"type": "input",
							"input": "text",
							"title": "Good"
						}
					],
					"expected_ids": ["good"]
				}
			]
		]
	},
	"test_schema_validate_ai_html_calls_set_html_field": {
		"entities": [
			[
				"FORM",
				{
					"name": "AI schema html",
					"hash": "form_ai_html",
					"form_type": "task",
					"ai_payload": [
						{
							"id": "intro",
							"type": "html",
							"title": "Intro",
							"content_markdown": "**Hello**"
						}
					],
					"expected_set_html_calls": [["intro", "<p><strong>Hello</strong></p>"]],
					"expected_ids": ["intro"]
				}
			]
		]
	},
	"test_schema_validate_ai_table_filters_bad_columns": {
		"entities": [
			[
				"FORM",
				{
					"name": "AI schema table columns",
					"hash": "form_ai_tbl",
					"ai_payload": [
						{
							"id": "rows",
							"type": "table",
							"title": "Rows",
							"columns": [
								{
									"id": "c_ok",
									"type": "input",
									"input": "text",
									"title": "Ok"
								},
								{
									"id": "c_bad",
									"type": "input",
									"input": "not_a_column_input",
									"title": "Bad"
								},
								{
									"id": "c_none_input",
									"type": "input",
									"input": null,
									"title": "Bad null input"
								},
								{
									"id": "c_none_type",
									"type": null,
									"title": "Bad null type"
								},
								{
									"id": null,
									"type": "checkbox",
									"title": "Bad null id"
								}
							]
						}
					],
					"expected_table_column_ids": ["c_ok"]
				}
			]
		]
	},
	"test_schema_previous_and_fields_cache": {
		"entities": [
			[
				"FORM",
				{
					"name": "Schema previous",
					"hash": "form_prev",
					"schema_first": [
						{
							"id": "a",
							"type": "input",
							"input": "text",
							"title": "A"
						}
					],
					"schema_second": [
						{
							"id": "b",
							"type": "input",
							"input": "text",
							"title": "B"
						}
					]
				}
			]
		]
	},
	"test_schema_required_fields": {
		"entities": [
			[
				"FORM",
				{
					"name": "Schema required",
					"hash": "form_req",
					"schema_value": [
						{
							"id": "opt",
							"type": "input",
							"input": "text",
							"title": "Optional",
							"required": false
						},
						{
							"id": "req",
							"type": "input",
							"input": "text",
							"title": "Required",
							"required": true
						}
					],
					"expected_required_ids": ["req"]
				}
			]
		]
	},
	"test_schema_create_field_unknown_returns_none": {
		"entities": [
			[
				"FORM",
				{
					"name": "Create field unknown",
					"hash": "form_cf0",
					"bad_definition": {
						"id": "x",
						"type": "input",
						"input": "unknown_input_xyz",
						"title": "X"
					}
				}
			]
		]
	},
	"test_schema_create_field_known_text_input": {
		"entities": [
			[
				"FORM",
				{
					"name": "Create field text",
					"hash": "form_cf1",
					"good_definition": {
						"id": "t",
						"type": "input",
						"input": "text",
						"title": "T"
					}
				}
			]
		]
	}
}
