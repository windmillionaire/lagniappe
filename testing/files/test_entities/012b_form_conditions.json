{
	"test_form_string_filters": {
		"entities": [
			[
				"FORM",
				{
					"name": "String Fields Form",
					"hash": "formstr",
					"schema": "text_input_only",
					"fields": [
						{
							"id": "input-textab12",
							"value": ["hello"],
							"comparator": "SUBSTRING",
							"expected_description": [
								"formstr",
								"input-textab12",
								"string",
								"substring",
								"hello"
							],
							"expected_details": {
								"type": "string",
								"text": "contains",
								"status": "SUBSTRING",
								"value": "hello",
								"field_label": "Text Field"
							}
						},
						{
							"id": "input-textab12",
							"value": ["Exact Match"],
							"comparator": "EQUALS",
							"expected_description": [
								"formstr",
								"input-textab12",
								"string",
								"eq",
								"Exact Match"
							],
							"expected_details": {
								"type": "string",
								"text": "matches",
								"status": "EQUALS",
								"value": "Exact Match",
								"field_label": "Text Field"
							}
						}
					]
				}
			]
		]
	},
	"test_form_boolean_filters": {
