			]
		]
	},
	"test_form_timestamp_filters": {
		"entities": [
			[
				"FORM",
				{
					"name": "Date Fields Form",
					"hash": "formdate",
					"schema": "date_time_inputs",
					"fields": [
						{
							"id": "input-dateab12",
							"value": ["2025-06-15"],
							"comparator": "LESS_THAN",
							"expected_description": [
								"formdate",
								"input-dateab12",
								"timestamp",
								"lt",
								"DYNAMIC_TIMESTAMP"
							],
							"expected_details": {
								"type": "timestamp",
								"text": "is before",
								"status": "LESS_THAN",
								"field_label": "Date Field"
							}
						},
						{
							"id": "input-dateab12",
							"value": ["2025-06-15"],
							"comparator": "EQUALS",
							"expected_description": [
								"formdate",
								"input-dateab12",
								"timestamp",
								"eq",
								"DYNAMIC_TIMESTAMP"
							],
							"expected_details": {
								"type": "timestamp",
								"text": "is on",
								"status": "EQUALS",
								"field_label": "Date Field"
							}
						},
						{
							"id": "input-dateab12",
							"value": ["2025-06-15"],
							"comparator": "GREATER_THAN",
							"expected_description": [
								"formdate",
								"input-dateab12",
								"timestamp",
								"gt",
								"DYNAMIC_TIMESTAMP"
							],
							"expected_details": {
								"type": "timestamp",
								"text": "is after",
								"status": "GREATER_THAN",
								"field_label": "Date Field"
							}
						},
						{
							"id": "input-dateab12",
							"value": ["2025-06-08", "2025-06-22"],
							"comparator": "BETWEEN",
							"expected_description": [
								"formdate",
								"input-dateab12",
								"timestamp",
								"between",
								["DYNAMIC_TIMESTAMP_START", "DYNAMIC_TIMESTAMP_END"]
							],
							"expected_details": {
								"type": "timestamp",
								"text": "is between",
								"status": "BETWEEN",
								"field_label": "Date Field"
							}
						},
						{
							"id": "input-timecd34",
							"value": ["14:30"],
							"comparator": "LESS_THAN",
							"expected_description": [
								"formdate",
								"input-timecd34",
								"timestamp",
								"lt",
								"DYNAMIC_TIMESTAMP"
							],
							"expected_details": {
								"type": "timestamp",
								"text": "is before",
								"status": "LESS_THAN",
								"field_label": "Time Field"
							}
						},
						{
							"id": "input-timecd34",
							"value": ["09:00"],
							"comparator": "EQUALS",
							"expected_description": [
								"formdate",
								"input-timecd34",
								"timestamp",
								"eq",
								"DYNAMIC_TIMESTAMP"
							],
							"expected_details": {
								"type": "timestamp",
								"text": "is at",
								"status": "EQUALS",
								"field_label": "Time Field"
							}
						}
					]
				}
			]
		]
	},
	"test_form_internal_link_filters": {
		"entities": [
			[
				"FORM",
				{
					"name": "Internal Link Form",
					"hash": "formlink",
					"schema": "submission_integration_links",
					"fields": [
						{
							"id": "top_link",
							"value": ["target1"],
							"expected_description": [
								"formlink",
								"top_link",
								"string",
								"eq",
								"target1",
								true
							],
							"expected_details": {
								"type": "string",
								"text": "matches",
								"status": "EQUALS",
								"value": "target1",
								"field_label": "Top link"
							}
						},
						{
							"id": "top_link",
							"value": ["target1", "target2"],
							"expected_description": [
								"formlink",
								"top_link",
								"string",
								"in",
								["target1", "target2"],
								true
							],
							"expected_details": {
								"type": "string",
								"text": "is in",
								"status": "IN",
								"value": ["target1", "target2"],
								"field_label": "Top link"
							}
						}
					]
				}
			],
			[
				"PAGE",
				{
					"name": "Target One",
					"hash": "target1"
				}
			],
			[
				"PAGE",
				{
					"name": "Target Two",
					"hash": "target2"
				}
			]
		]
	},
	"test_form_number_filters": {
		"entities": [
			[
				"FORM",
				{
					"name": "Number Fields Form",
					"hash": "formnum",
					"schema": "number_input_only",
					"fields": [
						{
							"id": "input-numab12",
							"value": ["42"],
							"comparator": "EQUALS",
							"expected_description": [
								"formnum",
								"input-numab12",
								"number",
								"eq",
								42.0
							],
							"expected_details": {
								"type": "number",
								"text": "equals",
								"status": "EQUALS",
								"value": 42.0,
								"field_label": "Number Field"
							}
						},
						{
							"id": "input-numab12",
							"value": ["100"],
							"comparator": "LESS_THAN",
							"expected_description": [
								"formnum",
								"input-numab12",
								"number",
								"lt",
								100.0
							],
							"expected_details": {
								"type": "number",
								"text": "is less than",
								"status": "LESS_THAN",
								"value": 100.0,
								"field_label": "Number Field"
							}
						},
						{
							"id": "input-numab12",
							"value": ["50"],
							"comparator": "GREATER_THAN",
							"expected_description": [
								"formnum",
								"input-numab12",
								"number",
								"gt",
								50.0
							],
							"expected_details": {
								"type": "number",
								"text": "is greater than",
								"status": "GREATER_THAN",
								"value": 50.0,
								"field_label": "Number Field"
							}
						},
						{
							"id": "input-numab12",
							"value": ["10", "100"],
							"comparator": "BETWEEN",
							"expected_description": [
								"formnum",
								"input-numab12",
								"number",
								"between",
								[10.0, 100.0]
							],
							"expected_details": {
								"type": "number",
								"text": "is between",
								"status": "BETWEEN",
								"value": [10.0, 100.0],
								"field_label": "Number Field"
							}
						}
					]
				}
			]
		]
	},
	"test_form_categorical_filters": {
		"entities": [
			[
				"FORM",
				{
					"name": "Categorical Fields Form",
					"hash": "formcat",
					"schema": "radio_only",
					"fields": [
						{
							"id": "radio-ab12",
							"value": ["opt1"],
							"expected_description": [
								"formcat",
								"radio-ab12",
								"list",
								"contains",
								"opt1"
							],
							"expected_details": {
								"type": "list",
								"text": "is",
								"status": "CONTAINS",
								"value": "Option One",
								"field_label": "Radio Field"
							}
						},
						{
							"id": "radio-ab12",
							"value": ["opt1", "opt2"],
							"expected_description": [
								"formcat",
								"radio-ab12",
								"list",
								"contains_any",
								["opt1", "opt2"]
							],
							"expected_details": {
								"type": "list",
								"text": "is any of",
								"status": "CONTAINS_ANY",
								"or": ["Option One", "Option Two"],
								"field_label": "Radio Field"
							}
						}
					]
				}
			]
		]
	},
