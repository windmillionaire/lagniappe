{
	"test_table_form_single_row": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Table form - single row",
					"hash": "page001",
					"form": {
						"name": "Form",
						"hash": "form001",
						"schema": "complex_types"
					},
					"form_submission": {
						"table-contactsab": "{\"rows\": [{\"row-namecd12\": \"John Doe\", \"row-emailef34\": \"john@example.com\", \"row-primarygh\": true}]}"
					},
					"expected": {
						"table-contactsab": {
							"value": {
								"rows": [
									{
										"row-namecd12": "John Doe",
										"row-emailef34": "john@example.com",
										"row-primarygh": true
									}
								]
							},
							"form_value": {
								"rows": [
									{
										"row-namecd12": "John Doe",
										"row-emailef34": "john@example.com",
										"row-primarygh": true
									}
								]
							},
							"column_value": { "num_rows": 1 },
							"ai_value": {
								"Contacts": [
									{
										"Name": "John Doe",
										"Email": "john@example.com",
										"Primary": "True"
									}
								]
							},
							"filter_value": {
								"row-namecd12": ["John Doe"],
								"row-emailef34": ["john@example.com"],
								"row-primarygh": [true]
							}
						}
					}
				}
			]
		]
	},
	"test_table_ai_multiple_rows": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Table AI - multiple rows",
					"hash": "page002",
					"form": {
						"name": "Form",
						"hash": "form002",
						"schema": "complex_types"
					},
					"ai_submission": {
						"table-contactsab": {
							"rows": [
								{
									"row-namecd12": "Alice",
									"row-emailef34": "alice@example.com",
									"row-primarygh": true
								},
								{
									"row-namecd12": "Bob",
									"row-emailef34": "bob@example.com",
									"row-primarygh": false
								}
							]
						}
					},
					"expected": {
						"table-contactsab": {
							"value": {
								"rows": [
									{
										"row-namecd12": "Alice",
										"row-emailef34": "alice@example.com",
										"row-primarygh": true
									},
									{
										"row-namecd12": "Bob",
										"row-emailef34": "bob@example.com",
										"row-primarygh": false
									}
								]
							},
							"form_value": {
								"rows": [
									{
										"row-namecd12": "Alice",
										"row-emailef34": "alice@example.com",
										"row-primarygh": true
									},
									{
										"row-namecd12": "Bob",
										"row-emailef34": "bob@example.com",
										"row-primarygh": false
									}
								]
							},
							"column_value": { "num_rows": 2 },
							"ai_value": {
								"Contacts": [
									{
										"Name": "Alice",
										"Email": "alice@example.com",
										"Primary": "True"
									},
									{
										"Name": "Bob",
										"Email": "bob@example.com",
										"Primary": "False"
									}
								]
							},
							"filter_value": {
								"row-namecd12": ["Alice", "Bob"],
								"row-emailef34": ["alice@example.com", "bob@example.com"],
								"row-primarygh": [true, false]
							}
						}
					}
				}
			]
		]
	},
