	"test_table_form_mixed_column_types": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Table mixed scalar columns (form)",
					"hash": "page_mix_form",
					"form": {
						"name": "Mixed form",
						"hash": "form_mix_form",
						"schema": "table_scalar_columns"
					},
					"form_submission": {
						"type_grid": "{\"rows\": [{\"cx_label\": \"Acme\", \"cx_time\": \"15:30\", \"cx_amt\": 3.5, \"cx_phone\": \"+12015550123\"}]}"
					},
					"expected": {
						"type_grid": {
							"value": {
								"rows": [
									{
										"cx_label": "Acme",
										"cx_time": "15:30",
										"cx_amt": 3.5,
										"cx_phone": "+12015550123"
									}
								]
							},
							"form_value": {
								"rows": [
									{
										"cx_label": "Acme",
										"cx_time": "15:30",
										"cx_amt": 3.5,
										"cx_phone": "+1 (201) 555-0123"
									}
								]
							},
							"column_value": { "num_rows": 1 },
							"search_value": { "[Type grid] Label": "Acme" },
							"ai_value": {
								"Type grid": [
									{
										"Label": "Acme",
										"At time": "15:30",
										"Amount": 3.5,
										"Phone": "+12015550123"
									}
								]
							},
							"filter_value": {
								"cx_label": ["Acme"],
								"cx_amt": [3.5],
								"cx_phone": ["+12015550123"]
							}
						}
					}
				}
			]
		]
	},
