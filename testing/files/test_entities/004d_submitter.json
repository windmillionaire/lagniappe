{
	"test_patch_submission_merges_multiple_fields": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Patch multi page",
					"hash": "pm1",
					"form": {
						"name": "F",
						"hash": "pmf1",
						"schema": "patch_title_slug"
					},
					"initial_submission": {"title": "Hello", "slug": "hello"},
					"patch_payload": {"title": "Hi", "slug": "hi"},
					"expected_submission": {"title": "Hi", "slug": "hi"}
				}
			]
		]
	},
	"test_import_submission_validation_error_includes_field_and_payload": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Import error page",
					"hash": "ie1",
					"form": {
						"name": "F",
						"hash": "ief1",
						"schema": "integration_two_column_table"
					},
					"import_submission": {"tbl": [["only_a"]]},
					"expected_error_substring": "tbl:"
				}
			]
		]
	}
