{
	"test_submission_db_value_omits_unset_number_field": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Db value drop empty number",
					"hash": "dbv1",
					"form": {
						"name": "F",
						"hash": "fdbv1",
						"schema": "submission_two_numbers"
					}
				}
			]
		]
	},
	"test_submission_search_value_merges_table_column_labels": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Search merge page",
					"hash": "sch1",
					"form": {
						"name": "F",
						"hash": "fsch1",
						"schema": "submission_headline_table"
					},
					"form_submission": {
						"headline": "Top story",
						"items": "{\"rows\": [{\"row_note\": \"Row one\"}]}"
					},
					"expected": {
						"headline": {
							"value": "Top story",
							"form_value": "Top story",
							"filter_value": "Top story",
							"ai_value": "Top story",
							"search_value": { "Headline": "Top story" }
						},
						"items": {
							"value": { "rows": [{ "row_note": "Row one" }] },
							"form_value": {
								"rows": [{ "row_note": "Row one" }]
							},
							"column_value": { "num_rows": 1 },
							"ai_value": {
								"Items": {"rows": [{ "row_note": "Row one" }]}
							},
								"filter_value": { "row_note": ["Row one"] }
							}
						},
						"expected_search": {
							"keys": ["Headline", "[Items] Note"],
							"values": ["Top story", "Row one"]
						}
					}
			]
		]
	},
	"test_submission_number_form_accepts_zero": {
		"entities": [
			[
				"PAGE",
				{
					"name": "Number zero page",
					"hash": "nz1",
					"form": {
						"name": "F",
						"hash": "fnz1",
						"schema": "number_input_only"
					},
					"form_submission": { "input-numab12": "0" },
					"expected": {
						"input-numab12": {
							"value": 0.0,
							"form_value": 0.0,
							"filter_value": 0.0,
							"ai_value": 0.0
						}
					}
				}
			]
		]
	}
}
