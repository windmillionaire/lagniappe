	"test_entity_requires": {
		"entities": [
			[
				"PROJECT",
				{
					"name": "Project",
					"hash": "proj123",
					"should_match": ["proj123", "models"]
				}
			],
			[
				"CATEGORY",
				{
					"name": "Category",
					"hash": "cat1234",
					"should_match": ["cat1234", "models"]
				}
			],
			[
				"PAGE",
				{
					"name": "Page with Categories",
					"hash": "page123",
					"categories": [
						{ "name": "Cat A", "hash": "cata123" },
						{ "name": "Cat B", "hash": "catb456" }
					],
					"should_match": ["page123", "cata123", "catb456", "models"]
				}
			],
			[
				"PAGE",
				{
					"name": "Page No Categories",
					"hash": "page456",
					"should_match": ["page456"]
				}
			],
			[
				"PAGE",
				{
					"name": "Page with Model",
					"hash": "page789",
					"model": { "name": "Model Category", "hash": "modcat1" },
					"should_match": ["page789", "modcat1", "models"]
				}
			],
			[
				"PAGE",
				{
					"name": "User Page",
					"hash": "usrpg12",
					"categories": [{ "name": "User Page Cat", "hash": "usrpcat" }],
					"user": {
						"name": "User Page Owner",
						"hash": "upown12",
						"groups": [{ "name": "User Page Group", "hash": "upgrp12" }]
					},
					"should_match": ["usrpg12", "users", "upgrp12", "models", "usrpcat"],
					"cache_should_match": ["users", "upgrp12"]
				}
			],
			[
				"TASK",
				{
					"name": "Task",
					"hash": "task123",
					"page": {
						"name": "Parent Page",
						"hash": "ppage12",
						"categories": [{ "name": "Task Cat", "hash": "tcat123" }]
					},
					"should_match": ["ppage12", "tcat123", "models"]
				}
			],
			[
				"MODEL_TASK",
				{
					"name": "Model",
					"hash": "model12",
					"project": { "name": "Parent Project", "hash": "pproj12" },
					"should_match": ["model12", "pproj12", "models"]
				}
			],
			[
				"USER",
				{
					"name": "User with Groups",
					"hash": "user123",
					"page": {
						"name": "User Page",
						"hash": "upage12",
						"categories": [{ "name": "User Cat", "hash": "ucat123" }]
					},
					"groups": [
						{ "name": "Group A", "hash": "grpa123" },
						{ "name": "Group B", "hash": "grpb456" }
					],
					"should_match": ["users", "grpa123", "grpb456"]
				}
			],
			[
				"USER",
				{
					"name": "User No Groups",
					"hash": "user456",
					"page": { "name": "User Page 2", "hash": "upage34" },
					"should_match": ["users"]
				}
			],
			[
				"FORM",
				{
					"name": "Form",
					"hash": "form123",
					"should_match": ["forms"]
				}
			],
			[
				"FILE",
				{
					"name": "File with Page",
					"hash": "file123",
					"page": { "name": "File Page", "hash": "fpage12", "categories": [] },
					"should_match": ["file123", "models", "fpage12"]
				}
			],
			[
				"FILE",
				{
					"name": "Unowned File",
					"hash": "file456",
					"should_match": ["file456", "models"]
				}
			],
			[
				"FILTER",
				{
					"name": "Filter",
					"hash": "filt123",
					"parent": {
						"_type": "PROJECT",
						"name": "Filtered Project",
						"hash": "fproj12"
					},
					"creator": {
						"name": "Creator",
						"hash": "creat12",
						"page": { "name": "Creator Page", "hash": "crpg12" }
					},
					"should_match": ["filt123", "fproj12", "creat12"]
				}
			],
			[
				"USER_GROUP",
				{
					"name": "User Group",
					"hash": "ugrp123",
					"should_match": ["ugrp123", "users"]
				}
			],
			[
				"PUBLIC_GROUP",
				{
					"name": "Public Group",
					"hash": "pgrp123",
					"should_match": ["pgrp123", "site"]
				}
			],
			[
				"INGRESS",
				{
					"name": "Ingress",
					"hash": "ingr123",
					"should_match": ["ingr123", "site"]
				}
			]
		]
	},
