	"test_entity_modified": {
		"entities": [
			[
				"PROJECT",
				{
					"name": "Chicago",
					"timezone": "America/Chicago",
					"stored": "2024-01-15T20:15:30+00:00",
					"expected_column": "2024-01-15T14:15:30-06:00",
					"filter": 1705349730.0,
					"input_local": "2024-06-15T14:30:00",
					"expected_stored": "2024-06-15T19:30:00+00:00"
				}
			],
			[
				"PAGE",
				{
					"name": "Tokyo",
					"timezone": "Asia/Tokyo",
					"stored": "2024-01-15T20:15:30+00:00",
					"expected_column": "2024-01-16T05:15:30+09:00",
					"filter": 1705349730.0,
					"input_local": "2024-06-15T14:30:00",
					"expected_stored": "2024-06-15T05:30:00+00:00"
				}
			],
			[
				"TASK",
				{
					"name": "London",
					"timezone": "Europe/London",
					"stored": "2024-01-15T20:15:30+00:00",
					"expected_column": "2024-01-15T20:15:30+00:00",
					"filter": 1705349730.0,
					"input_local": "2024-06-15T14:30:00",
					"expected_stored": "2024-06-15T13:30:00+00:00"
				}
			],
			[
				"CATEGORY",
				{
					"name": "NYC",
					"timezone": "America/New_York",
					"stored": "2024-01-15T20:15:30+00:00",
					"expected_column": "2024-01-15T15:15:30-05:00",
					"filter": 1705349730.0,
					"input_local": "2024-06-15T14:30:00",
					"expected_stored": "2024-06-15T18:30:00+00:00"
				}
			]
		]
	},
