{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"erasableSyntaxOnly": true,
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": []
	},
	"include": [
		"src/script/views/builder/config.mjs",
		"src/script/types/**/*.d.ts"
	],
	"exclude": ["testing/"]
}
