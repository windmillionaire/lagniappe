        "type": "integer",
        "const": 10
      },
      "contract_url": {
        "type": "string",
        "format": "uri"
      },
      "submit_url": {
        "type": "string",
        "format": "uri"
      },
      "status_url": {
        "type": "string",
        "format": "uri"
      },
      "preview_url": {
        "type": "string",
        "format": "uri"
      },
      "review_url": {
        "type": "string",
        "format": "uri"
      },
      "proposal": {
        "oneOf": [
          {
            "type": "object"
          },
          {
            "type": "null"
          }
        ]
